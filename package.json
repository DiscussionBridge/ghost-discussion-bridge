{
  "name": "ghost-discussion-bridge",
  "version": "0.4.0-alpha.1",
  "private": true,
  "type": "module",
  "files": [
    "assets/",
    "demo/",
    "docs/",
    "public/",
    "scripts/build-browser.mjs",
    "scripts/check.mjs",
    "scripts/prepare-installation.mjs",
    "scripts/refresh-contract.mjs",
    "scripts/managed-output.mjs",
    "scripts/bundled-license.mjs",
    "scripts/check-package.mjs",
    "src/*.mjs",
    "lib/*.mjs",
    "lib/cms-schema.json",
    "lib/PROVENANCE.json",
    "lib/idna/",
    "discussionbridge-release.json",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build:browser": "node scripts/build-browser.mjs",
    "start": "node src/index.mjs",
    "sync:publications": "node src/sync-publications.mjs",
    "install:rich-content": "node src/install-rich-content.mjs",
    "prepare:install": "node scripts/prepare-installation.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build:browser && node scripts/check.mjs"
  },
  "dependencies": {
    "sanitize-html": "2.18.1",
    "entities": "8.0.0",
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "katex": "0.18.2",
    "mermaid": "11.17.2",
    "dompurify": "3.4.17",
    "playwright-core": "1.62.1"
  },
  "overrides": { "mermaid": { "katex": "$katex", "dompurify": "$dompurify" } },
  "engines": { "node": ">=22" }
}
