# One V4 development connection. Copy to an owner-only configuration directory.
# These paths are examples, not supplied credentials or an installed service.
DISCUSSIONBRIDGE_SERVER_URL=https://forum.example
DISCUSSIONBRIDGE_CONNECTION_ID=dbc_0123456789abcdef01234567
DISCUSSIONBRIDGE_CONNECTION_SECRET_FILE=/srv/discussionbridge-ghost/private/connection-secret
DISCUSSIONBRIDGE_GHOST_ORIGIN=https://ghost.example
DISCUSSIONBRIDGE_ADAPTER_ORIGIN=https://adapter.example
DISCUSSIONBRIDGE_GHOST_WEBHOOK_SECRET_FILE=/srv/discussionbridge-ghost/private/webhook-secret
DISCUSSIONBRIDGE_GHOST_ADMIN_API_KEY_FILE=/srv/discussionbridge-ghost/private/ghost-admin-key
DISCUSSIONBRIDGE_STATE_FILE=/srv/discussionbridge-ghost/state/state.json
DISCUSSIONBRIDGE_PORT=8792

# Optional native selections. No Bridge protocol/profile selectors exist.
# DISCUSSIONBRIDGE_GHOST_ADMIN_ORIGIN=https://private-admin.example
# DISCUSSIONBRIDGE_OPERATOR_PASSWORD_FILE=/srv/discussionbridge-ghost/private/operator-password
# DISCUSSIONBRIDGE_OPERATOR_ORIGIN=https://adapter.example
# Optional actual installed source URL-move integration; no theme/route default.
# DISCUSSIONBRIDGE_SOURCE_NATIVE_INTEGRATION_FILE=/srv/discussionbridge-ghost/private/source-native-integration.json
# DISCUSSIONBRIDGE_LANE=default
DISCUSSIONBRIDGE_PUBLICATION_TYPE=post
DISCUSSIONBRIDGE_SOURCE_SYNC_INTERVAL_SECONDS=0
DISCUSSIONBRIDGE_WEBHOOK_MAX_BYTES=131072

# Standalone public-reader label only: unset uses the safely obtained native
# forum title. Explicit blank/invalid names stop with configuration attention.
# The connected V4 label is authoritative Connection.forum_name.
# DISCUSSIONBRIDGE_FORUM_NAME="Community Forum"
